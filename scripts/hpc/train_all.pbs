#!/bin/bash
# PBS job for the whole batch (the GPU equivalent of running
# `bash scripts/run_all.sh` locally). Submit directly, no wrapper script:
#
#   qsub scripts/hpc/train_all.pbs
#
# Edit the #PBS resource lines below directly for your cluster/batch size
# (same idea as editing the DATASETS/MODELS arrays directly in
# scripts/run_all.sh to change what runs -- that script is untouched by
# this file, and not re-edited here). Runs straight from $PBS_O_WORKDIR --
# no scratch copy, no mirroring: reads data/ and writes runs/+logs/ in
# place in the repo.
#
#PBS -N stnf_train_all
#PBS -l ncpus=4
#PBS -l ngpus=1
#PBS -l mem=32gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -k oe
# Uncomment and fill in if your cluster requires picking a queue/project
# code explicitly (check `qstat -Q`, or your facility's docs, for the right
# values -- some clusters route GPU jobs automatically from -l ngpus=N alone):
# #PBS -q <queue_name>
# #PBS -P <project_code>

set -euo pipefail

cd "${PBS_O_WORKDIR:?this script must be run under PBS, or with PBS_O_WORKDIR set for local testing}"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate spatial-temporal   # edit this name if your conda env is called something else

mkdir -p logs
LOG_FILE="logs/${PBS_JOBID:-local.$$}.log"
echo "[setup] host=$(hostname)  job=${PBS_JOBID:-local}  workdir=$(pwd)"

bash scripts/run_all.sh 2>&1 | tee "${LOG_FILE}"
