# Cluster-specific settings for scripts/hpc/submit_train.sh + train.pbs.
#
# Copy this file to scripts/hpc/hpc.env (gitignored -- it's local-machine
# config, not something to commit) and fill in the values for YOUR cluster.
# Nothing outside scripts/hpc/ reads this file.
#
#   cp scripts/hpc/hpc.env.example scripts/hpc/hpc.env
#   <edit it>

# Base scratch directory: a fast, large-quota filesystem meant for job-local
# working data (NOT your home/project directory, which is usually small-quota
# and/or slower for heavy per-step checkpoint I/O). The exact path is
# cluster-specific -- check your HPC facility's docs or ask admins/support if
# you don't already know it. Common patterns: /scratch/$USER,
# /scratch/<project_code>/$USER, $TMPDIR, $PBS_JOBFS.
SCRATCH_BASE="/scratch/${USER:-$(id -un)}"

# PBS queue to submit GPU jobs to. Check `qstat -Q` on the cluster, or your
# facility's docs, for the right queue name (e.g. "gpu", "gpuvolta", "dgxa100").
DEFAULT_QUEUE="gpu"

# PBS project/account code, if your cluster requires one (most shared
# university/national facilities do, for usage accounting). Leave empty to
# omit the -P flag entirely.
PROJECT_CODE=""

# Default resource request -- overridable per-submission via
# submit_train.sh's --walltime/--ncpus/--mem/--gpus flags.
DEFAULT_WALLTIME="04:00:00"
DEFAULT_NCPUS="4"
DEFAULT_MEM="32gb"
DEFAULT_GPUS="1"

# How train.pbs brings up the Python environment once it's running on the
# compute node, inside the *copied* scratch repo (so this runs with cwd =
# the scratch repo root). Edit this to match your cluster's module/conda
# setup -- it is deliberately left as a placeholder that fails loudly rather
# than silently doing nothing, since a guessed-wrong module name here would
# otherwise fail confusingly deep inside the training script instead.
setup_environment() {
  cat >&2 <<'EOF'
[hpc.env] setup_environment() is a placeholder in scripts/hpc/hpc.env.
Edit it to load the modules / activate the conda or venv environment your
cluster needs, then remove this placeholder block. For example:

  module purge
  module load cuda/12.1
  module load miniconda3
  source activate st-numeric-baselines   # conda env with requirements.txt + torch installed

or, for a venv-based setup:

  module load python/3.11
  source "$HOME/envs/st-numeric-baselines/bin/activate"
EOF
  exit 1
}
