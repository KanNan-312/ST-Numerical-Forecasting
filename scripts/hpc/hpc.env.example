# Cluster-specific settings for scripts/hpc/submit_train.sh + train.pbs
# (and submit_all.sh + train_all.pbs, minus SCRATCH_BASE below -- that batch
# job runs scripts/run_all.sh straight from $PBS_O_WORKDIR, no scratch copy).
#
# Copy this file to scripts/hpc/hpc.env (gitignored -- it's local-machine
# config, not something to commit) and fill in the values for YOUR cluster.
# Nothing outside scripts/hpc/ reads this file.
#
#   cp scripts/hpc/hpc.env.example scripts/hpc/hpc.env
#   <edit it>

# Base scratch directory: a fast, large-quota filesystem meant for job-local
# working data (NOT your home/project directory, which is usually small-quota
# and/or slower for heavy per-step checkpoint I/O). Only train.pbs (the
# single dataset+model job) uses this -- it appends "${USER}_<jobid>" itself
# (matching the facility's own example job script), so just the base path
# goes here -- usually plain "/scratch", but check your HPC facility's
# docs/support if unsure (other common patterns: /scratch/<project_code>,
# $TMPDIR, $PBS_JOBFS).
SCRATCH_BASE="/scratch"

# PBS queue to submit GPU jobs to, if your cluster requires picking one
# explicitly for GPU resources (some route automatically based on the -l
# ngpus=N request alone, like the facility's own example script implies --
# leave this empty in that case). Check `qstat -Q`, or your facility's docs,
# for the right queue name if you do need one (e.g. "gpu", "gpuvolta").
DEFAULT_QUEUE=""

# PBS project/account code, if your cluster requires one (most shared
# university/national facilities do, for usage accounting). Leave empty to
# omit the -P flag entirely.
PROJECT_CODE=""

# Default resource request -- overridable per-submission via
# submit_train.sh's --walltime/--ncpus/--mem/--gpus flags.
DEFAULT_WALLTIME="04:00:00"
DEFAULT_NCPUS="4"
DEFAULT_MEM="32gb"
DEFAULT_GPUS="1"

# Name of the conda env (with requirements.txt + torch already installed)
# that train.pbs/train_all.pbs should activate once running on the compute
# node.
CONDA_ENV_NAME="st-numeric-baselines"

# How train.pbs brings up the Python environment, called after the
# repo+data are copied to scratch (don't rely on cwd here). `conda activate`
# needs conda's shell function loaded first -- plain `conda activate` fails
# with "Run 'conda init' before 'conda activate'" in a non-interactive job
# shell otherwise. Add a `module load <your cluster's conda module>` line
# above the `source` call if conda isn't already on PATH on compute nodes.
setup_environment() {
  source "$(conda info --base)/etc/profile.d/conda.sh"
  conda activate "${CONDA_ENV_NAME}"
}
